+def fixed_layout_seq_lengths(cu_seqlens: torch.Tensor | None, capacity: int) -> list[int] | None:
+    """Accept one real sequence; ignore repeated endpoints / trailing zero padding.
+
+    Unlike TND metadata, fixed-layout lengths are per-batch lengths. Never append
+    the captured budget: padded tokens must not become real keys or another image.
+    """
+    if cu_seqlens is None:
+        return None
+    flat = cu_seqlens.detach().cpu().view(-1).tolist()
+    if len(flat) < 2 or flat[0] != 0 or not 1 < flat[1] <= capacity:
+        return None
+    length = flat[1]
+    zero_padding = False
+    for endpoint in flat[2:]:
+        if endpoint == 0:
+            zero_padding = True
+        elif endpoint != length or zero_padding:
+            return None
+    return [length]
+
